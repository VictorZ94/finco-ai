# Copy to .env (next to manage.py) and fill in. Real environment variables override .env.
# Settings module: manage.py uses finco_ai.settings.dev, wsgi/asgi use finco_ai.settings.prod;
# override with DJANGO_SETTINGS_MODULE.

# Required everywhere. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=

# Dev only (prod forces DEBUG=False).
DEBUG=True

# Comma-separated. Required in prod.
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL, used by both docker-compose.yaml (docker compose up -d) and Django.
# POSTGRES_DB is only applied when the container's volume is first created;
# changing it later does not rename or create the database.
POSTGRES_DB=finco_ai
POSTGRES_USER=finco_ai
POSTGRES_PASSWORD=
# Use 127.0.0.1, not localhost: on Windows, localhost tries IPv6 first and hangs on Docker.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Firebase Authentication (Firebase console > Project settings).
# Service account (Service accounts > Generate new private key). Paste private_key on ONE
# line, keeping the literal \n sequences, wrapped in double quotes.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Web app config (General > Your apps), used by the Django admin sign-in page.
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
# Comma-separated Firebase UIDs allowed into /admin/ (Authentication > Users > User UID).
FIREBASE_ADMIN_UIDS=

# Chat agent (ai_chat): Ollama cloud API key from https://ollama.com/settings/keys.
# Messages and account names are sent to OLLAMA_HOST; use http://127.0.0.1:11434 for a local model.
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:31b
# OLLAMA_TIMEOUT=60
# Chat memory: summarize a conversation past this many tokens, keeping the last N messages as they are.
# CHAT_SUMMARY_TRIGGER_TOKENS=4000
# CHAT_SUMMARY_KEEP_MESSAGES=20

# Prod only.
# CSRF_TRUSTED_ORIGINS=https://finco.ai
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=3600
# BEHIND_PROXY=False
